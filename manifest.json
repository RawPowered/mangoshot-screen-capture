{
  "manifest_version": 3,
  "name": "MangoShot",
  "version": "0.6.18",
  "description": "MangoShot editable layer clipboard, layer-stack drag reorder, canvas Alt-drag cloning, live layer appearance and selection-aware keyboard shortcuts.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_title": "MangoShot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "capture-store.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mangoshot@rawpowered.dev",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "version_name": "0.7.38 Zoom Studio Recovery preview"
}
