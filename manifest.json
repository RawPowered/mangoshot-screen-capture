{
  "manifest_version": 3,
  "name": "MangoShot",
  "description": "Local-first screenshots, ink annotations and screen recordings.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "downloads"
  ],
  "host_permissions": [],
  "action": {
    "default_title": "MangoShot",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mangoshot@rawpowered.dev",
      "strict_min_version": "128.0"
    }
  }
}
